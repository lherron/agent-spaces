{
  "name": "spaces-integration-tests",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun ../scripts/run-tests-no-git-clone.ts -- bun test",
    "typecheck": "tsc --noEmit",
    "test:agent-resource-parity": "bun ../scripts/run-tests-no-git-clone.ts -- bun test tests/agent-resource-parity.test.ts",
    "verify:agent-resources": "bun ../scripts/run-tests-no-git-clone.ts -- bun bin/verify-agent-resource-parity.ts --mode all",
    "test:real-claude": "RUN_REAL_CLAUDE=1 bun ../scripts/run-tests-no-git-clone.ts -- bun test"
  },
  "devDependencies": {
    "@types/bun": "^1.1.14",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.84.3",
    "@lherron/agent-spaces": "*",
    "agent-harness-runtime": "workspace:*",
    "agent-scope": "*",
    "agent-spaces": "workspace:*",
    "spaces-config": "*",
    "spaces-execution": "*",
    "spaces-harness-broker-protocol": "workspace:*",
    "spaces-harness-pi-sdk": "workspace:*",
    "spaces-runtime": "workspace:*",
    "spaces-runtime-contracts": "workspace:*",
    "spaces-turn-runner": "*"
  }
}
