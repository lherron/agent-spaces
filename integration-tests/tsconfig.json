{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    // Typecheck-only: this package is private, has no `build` script, and
    // deep-imports sibling package sources, so `rootDir`/`outDir` produced
    // nothing but TS6059 noise.
    "noEmit": true,
    "types": ["bun-types"]
  },
  "include": ["tests/**/*.ts", "lib/**/*.ts", "bin/**/*.ts"],
  // The typecheck debt ledger T-07687 opened here (23 leaf test files, 375
  // errors) was cleared to zero by T-07689 and is gone. Every file this package
  // includes is typechecked. Do not reintroduce a per-file exclusion to get a
  // red file past the gate -- fix the file. `tests/install.test.ts` is why the
  // gate exists at all: it called a `PathResolver.store` getter that has never
  // existed, and with no `typecheck` script nothing ever said so.
  "exclude": ["node_modules", "dist"]
}
