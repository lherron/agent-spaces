{
  "name": "agent-harness-sdk",
  "version": "0.1.1",
  "description": "ASP-aware construction of first-party Pi-backed agent sessions",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepack": "bun ../../scripts/strip-bun-exports.ts",
    "postpack": "git checkout HEAD -- package.json"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.84.3",
    "agent-scope": "workspace:*",
    "spaces-config": "workspace:*",
    "spaces-execution": "workspace:*",
    "spaces-harness-pi-sdk": "workspace:*",
    "spaces-runtime": "workspace:*",
    "spaces-runtime-contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "^5.8.3"
  }
}
