{
  "name": "spaces-aspc-protocol",
  "version": "0.1.1",
  "description": "ASPC JSON-RPC compiler protocol types and validators",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./agent-inspection": {
      "bun": "./src/agent-inspection.ts",
      "types": "./dist/agent-inspection.d.ts",
      "import": "./dist/agent-inspection.js"
    },
    "./unix-client": {
      "bun": "./src/unix-client.ts",
      "types": "./dist/unix-client.d.ts",
      "import": "./dist/unix-client.js"
    }
  },
  "typesVersions": {
    "*": {
      "agent-inspection": [
        "dist/agent-inspection.d.ts"
      ],
      "unix-client": [
        "dist/unix-client.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepack": "bun ../../scripts/strip-bun-exports.ts",
    "postpack": "git checkout HEAD -- package.json"
  },
  "dependencies": {
    "spaces-harness-broker-client": "workspace:*",
    "spaces-harness-broker-protocol": "workspace:*",
    "spaces-runtime-contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "^5.8.3"
  }
}
